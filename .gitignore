# Derived index (regenerable from store/*.md) — never versioned
store/.index.db*
store/.embed.db*
store/.sessions.db*
store/.access.db*

# Raw episodic staging (captured by hooks, pre-consolidation)
staging/

# Recall benchmark built from your own transcripts (recall.py eval --build):
# it holds their paths and message ids, so it stays on the machine
eval/

# Standalone web server runtime
.web-server.pid
.web-server.log

# macOS / Python
.DS_Store
__pycache__/
*.pyc

# Per-machine local config (MEM_PHP, MEM_UI_LANG, ...)
.mem-local.env
